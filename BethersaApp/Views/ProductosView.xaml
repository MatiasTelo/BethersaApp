<UserControl x:Class="BethersaApp.Views.ProductosView"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
         xmlns:local="clr-namespace:BethersaApp.Views"
         xmlns:converters="clr-namespace:BethersaApp.Converters"
         mc:Ignorable="d" 
         d:DesignHeight="700" d:DesignWidth="1000">
    
<UserControl.Resources>
<converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
<converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        
<Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="#3d5a80"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
        
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="#98c1d9"/>
        <Setter Property="Foreground" Value="#293241"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
        
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Background" Value="#e63946"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
        
    <Style x:Key="SuccessButton" TargetType="Button">
        <Setter Property="Background" Value="#2a9d8f"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
        
    <Style x:Key="FormLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="Foreground" Value="#555"/>
    </Style>
        
    <Style x:Key="FormTextBox" TargetType="TextBox">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="BorderBrush" Value="#ddd"/>
    </Style>
</UserControl.Resources>
    
<TabControl SelectionChanged="TabControl_SelectionChanged">
<!-- Tab de ABM Productos -->
<TabItem Header="Productos">
        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>
                
            <!-- Lista de productos -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,5,0" Padding="15">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Lista de Productos" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                        
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="+ Nuevo" Style="{StaticResource PrimaryButton}" 
                                    Command="{Binding NuevoProductoCommand}" Margin="0,0,5,0"/>
                            <Button Content="Editar" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding EditarProductoCommand}" Margin="0,0,5,0"/>
                            <Button Content="Eliminar" Style="{StaticResource DangerButton}" 
                                    Command="{Binding EliminarProductoCommand}" Margin="0,0,5,0"/>
                            <Button Content="Importar CSV" Style="{StaticResource PrimaryButton}" 
                                    Command="{Binding ImportarCsvCommand}"/>
                        </StackPanel>
                        
                        <!-- Buscador -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="10,8" FontSize="13" BorderBrush="#ddd"/>
                            <TextBlock Text="Buscar por codigo o nombre..." 
                                       IsHitTestVisible="False" Padding="12,10" Foreground="#999"
                                       Visibility="{Binding TextoBusqueda, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>
                        
                        <DataGrid ItemsSource="{Binding Productos}" 
                                  SelectedItem="{Binding ProductoSeleccionado}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="1"
                                  BorderBrush="#e0e0e0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Codigo" Binding="{Binding Codigo}" Width="100"/>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="180"/>
                                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="100"/>
                                <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="60"/>
                                <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C2}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                
                <!-- GridSplitter para redimensionar -->
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" 
                              Background="#e0e0e0" Cursor="SizeWE"/>
                
                <!-- Panel derecho -->
                <Border Grid.Column="2" Background="White" CornerRadius="8" Margin="5,0,0,0" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Formulario de edicion -->
                            <Border Visibility="{Binding ModoEdicion, Converter={StaticResource BoolToVis}}" 
                                    Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Datos del Producto" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,15"/>
                                    
                                    <TextBlock Text="Codigo *" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                    
                                    <TextBlock Text="Nombre *" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                    
                                    <TextBlock Text="Categoria" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding Categoria, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                    
                                    <TextBlock Text="Proveedor" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding Proveedor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                    
                                    <TextBlock Text="Precio" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding Precio, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                    
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" 
                                                Command="{Binding CancelarCommand}" Margin="0,0,10,0"/>
                                        <Button Content="Guardar" Style="{StaticResource PrimaryButton}" 
                                                Command="{Binding GuardarProductoCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            
                            <!-- Gestion de Stock -->
                            <Border Background="#f8f9fa" CornerRadius="8" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Gestion de Stock" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,15"/>
                                    
                                    <TextBlock Text="Producto seleccionado:" FontSize="12" Foreground="#666"/>
                                    <TextBlock Text="{Binding ProductoSeleccionado.Nombre, FallbackValue='Ninguno'}" 
                                               FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBlock FontSize="12" Foreground="#666">
                                        <Run Text="Stock actual: "/>
                                        <Run Text="{Binding ProductoSeleccionado.Stock, FallbackValue='0'}" FontWeight="Bold"/>
                                    </TextBlock>
                                    
                                    <Separator Margin="0,15"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Cantidad a agregar" 
                                                   Style="{StaticResource FormLabel}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Motivo" 
                                                   Style="{StaticResource FormLabel}"/>
                                        
                                        <TextBox Grid.Row="1" Grid.Column="0" 
                                                 Text="{Binding CantidadAgregarStock, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource FormTextBox}" Margin="0,0,10,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" 
                                                 Text="{Binding MotivoStock, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource FormTextBox}"/>
                                    </Grid>
                                    
                                    <Button Content="+ Agregar Stock" Style="{StaticResource SuccessButton}" 
                                            Command="{Binding AgregarStockCommand}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </TabItem>
        
        
        <!-- Tab de Ranking -->
        <TabItem Header="Ranking de Ventas" x:Name="TabRanking">
            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Ranking General -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Ranking General de Ventas" 
                                   FontWeight="SemiBold" FontSize="16" Margin="0,0,0,15"/>
                        
                        <DataGrid ItemsSource="{Binding RankingGeneral}" 
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="1"
                                  BorderBrush="#e0e0e0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Codigo" Binding="{Binding Codigo}" Width="100"/>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                                <DataGridTextColumn Header="Cant. Vendida" Binding="{Binding CantidadVendida}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                
                <!-- Ranking por Cliente -->
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Ranking por Cliente" 
                                   FontWeight="SemiBold" FontSize="16" Margin="0,0,0,15"/>
                        
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <ComboBox ItemsSource="{Binding Clientes}" 
                                      SelectedItem="{Binding ClienteRankingSeleccionado}"
                                      DisplayMemberPath="Nombre"
                                      Width="200" Padding="8" Margin="0,0,10,0"/>
                            <Button Content="Ver Ranking" Style="{StaticResource PrimaryButton}" 
                                    Command="{Binding CargarRankingClienteCommand}"/>
                        </StackPanel>
                        
                        <DataGrid ItemsSource="{Binding RankingPorCliente}" 
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="1"
                                  BorderBrush="#e0e0e0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Codigo" Binding="{Binding Codigo}" Width="100"/>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                                <DataGridTextColumn Header="Cant. Comprada" Binding="{Binding CantidadVendida}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
