<UserControl x:Class="BethersaApp.Views.CuentaCorrienteView"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
         xmlns:local="clr-namespace:BethersaApp.Views"
         xmlns:converters="clr-namespace:BethersaApp.Converters"
         mc:Ignorable="d" 
         d:DesignHeight="700" d:DesignWidth="1100">
    
<UserControl.Resources>
    <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="#3d5a80"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
        
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="#98c1d9"/>
        <Setter Property="Foreground" Value="#293241"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    
    <Style x:Key="SuccessButton" TargetType="Button">
        <Setter Property="Background" Value="#2a9d8f"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
        
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Background" Value="#e63946"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
        
    <Style x:Key="FormLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="Foreground" Value="#555"/>
    </Style>
        
    <Style x:Key="FormTextBox" TargetType="TextBox">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="BorderBrush" Value="#ddd"/>
    </Style>
</UserControl.Resources>

<TabControl>
    <!-- Tab de Cuenta Corriente Clientes -->
    <TabItem Header="Clientes">
        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" MinWidth="280"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>
            
            <!-- Lista de clientes con saldo -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,5,0" Padding="15">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Cuentas de Clientes" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                    
                    <!-- Buscador -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox Text="{Binding TextoBusquedaCliente, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="10,8" FontSize="13" BorderBrush="#ddd"/>
                        <TextBlock Text="Buscar cliente..." 
                                   IsHitTestVisible="False" Padding="12,10" Foreground="#999"
                                   Visibility="{Binding TextoBusquedaCliente, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>
                    
                    <DataGrid ItemsSource="{Binding ResumenClientes}" 
                              SelectedItem="{Binding ClienteCuentaSeleccionado}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="1"
                              BorderBrush="#e0e0e0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Codigo" Binding="{Binding Codigo}" Width="70"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Saldo" Binding="{Binding SaldoActual, StringFormat=C2}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="5,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SaldoActual, Converter={x:Static local:PositiveConverter.Instance}}" Value="True">
                                                <Setter Property="Foreground" Value="#e63946"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            
            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" 
                          Background="#e0e0e0" Cursor="SizeWE"/>
            
            <!-- Panel derecho - Movimientos y Pagos -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Margin="5,0,0,0" Padding="15">
                <DockPanel>
                    <!-- Encabezado con info del cliente seleccionado -->
                    <Border DockPanel.Dock="Top" Background="#f8f9fa" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cliente seleccionado:" FontSize="12" Foreground="#666"/>
                                <TextBlock Text="{Binding ClienteCuentaSeleccionado.Nombre, FallbackValue='Ninguno'}" 
                                           FontWeight="Bold" FontSize="18"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="Saldo actual:" FontSize="12" Foreground="#666" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding ClienteCuentaSeleccionado.SaldoActual, StringFormat=C2, FallbackValue='$0.00'}" 
                                           FontWeight="Bold" FontSize="24" Foreground="#e63946" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Formulario de pago -->
                    <Border DockPanel.Dock="Top" Background="#e8f5e9" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Registrar Pago" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Monto *" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding MontopagoCliente, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource FormTextBox}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Nro. Comprobante" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding ComprobantePagoCliente, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource FormTextBox}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                    <TextBlock Text="Descripcion" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding DescripcionPagoCliente, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource FormTextBox}"/>
                                </StackPanel>
                                
                                <Button Grid.Column="3" Content="Registrar Pago" Style="{StaticResource SuccessButton}" 
                                        Command="{Binding RegistrarPagoClienteCommand}" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Lista de movimientos -->
                    <TextBlock DockPanel.Dock="Top" Text="Historial de Movimientos" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                    
                    <DataGrid ItemsSource="{Binding MovimientosCliente}" 
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="1"
                              BorderBrush="#e0e0e0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="90"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoMovimiento}" Width="80"/>
                            <DataGridTextColumn Header="Comprobante" Binding="{Binding NumeroComprobante}" Width="100"/>
                            <DataGridTextColumn Header="Descripcion" Binding="{Binding Descripcion}" Width="*"/>
                            <DataGridTextColumn Header="Debe" Binding="{Binding Debe, StringFormat=C2}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#e63946"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Haber" Binding="{Binding Haber, StringFormat=C2}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#2a9d8f"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo, StringFormat=C2}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </TabItem>
    
    <!-- Tab de Cuenta Corriente Proveedores -->
    <TabItem Header="Proveedores">
        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" MinWidth="280"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="500"/>
            </Grid.ColumnDefinitions>
            
            <!-- Lista de proveedores con saldo -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,5,0" Padding="15">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Cuentas de Proveedores" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                    
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+ Nuevo" Style="{StaticResource PrimaryButton}" 
                                Command="{Binding NuevoProveedorCommand}" Margin="0,0,5,0"/>
                        <Button Content="Editar" Style="{StaticResource SecondaryButton}" 
                                Command="{Binding EditarProveedorCommand}" Margin="0,0,5,0"/>
                        <Button Content="Eliminar" Style="{StaticResource DangerButton}" 
                                Command="{Binding EliminarProveedorCommand}"/>
                    </StackPanel>
                    
                    <!-- Buscador -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox Text="{Binding TextoBusquedaProveedor, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="10,8" FontSize="13" BorderBrush="#ddd"/>
                        <TextBlock Text="Buscar proveedor..." 
                                   IsHitTestVisible="False" Padding="12,10" Foreground="#999"
                                   Visibility="{Binding TextoBusquedaProveedor, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>
                    
                    <DataGrid ItemsSource="{Binding ResumenProveedores}" 
                              SelectedItem="{Binding ProveedorCuentaSeleccionado}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="1"
                              BorderBrush="#e0e0e0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Codigo" Binding="{Binding Codigo}" Width="70"/>
                            <DataGridTextColumn Header="Proveedor" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Saldo" Binding="{Binding SaldoActual, StringFormat=C2}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="5,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SaldoActual, Converter={x:Static local:PositiveConverter.Instance}}" Value="True">
                                                <Setter Property="Foreground" Value="#e63946"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            
            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" 
                          Background="#e0e0e0" Cursor="SizeWE"/>
            
            <!-- Panel derecho -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Margin="5,0,0,0" Padding="15">
                <DockPanel>
                    <!-- Formulario de edicion de proveedor -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,15"
                            Visibility="{Binding ModoEdicionProveedor, Converter={StaticResource BoolToVis}}">
                        <Border Background="#fff3cd" CornerRadius="5" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Datos del Proveedor" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Codigo *" Style="{StaticResource FormLabel}"/>
                                        <TextBox Text="{Binding CodigoProveedor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Text="Nombre *" Style="{StaticResource FormLabel}"/>
                                        <TextBox Text="{Binding NombreProveedor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Direccion" Style="{StaticResource FormLabel}"/>
                                        <TextBox Text="{Binding DireccionProveedor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="Localidad" Style="{StaticResource FormLabel}"/>
                                        <TextBox Text="{Binding LocalidadProveedor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Telefono" Style="{StaticResource FormLabel}"/>
                                        <TextBox Text="{Binding TelefonoProveedor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="2" Grid.Column="1">
                                        <TextBlock Text="CUIT" Style="{StaticResource FormLabel}"/>
                                        <TextBox Text="{Binding CuitProveedor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" 
                                                Command="{Binding CancelarProveedorCommand}" Margin="0,0,10,0"/>
                                        <Button Content="Guardar" Style="{StaticResource PrimaryButton}" 
                                                Command="{Binding GuardarProveedorCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Border>
                    
                    <!-- Encabezado con info del proveedor seleccionado -->
                    <Border DockPanel.Dock="Top" Background="#f8f9fa" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Proveedor seleccionado:" FontSize="12" Foreground="#666"/>
                                <TextBlock Text="{Binding ProveedorCuentaSeleccionado.Nombre, FallbackValue='Ninguno'}" 
                                           FontWeight="Bold" FontSize="18"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="Saldo actual (lo que debemos):" FontSize="12" Foreground="#666" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding ProveedorCuentaSeleccionado.SaldoActual, StringFormat=C2, FallbackValue='$0.00'}" 
                                           FontWeight="Bold" FontSize="24" Foreground="#e63946" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Formulario de movimiento -->
                    <Border DockPanel.Dock="Top" Background="#e3f2fd" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Registrar Movimiento" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Tipo" Style="{StaticResource FormLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <RadioButton Content="Deuda/Factura" IsChecked="{Binding EsDeudaProveedor}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                        <RadioButton Content="Pago" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Monto *" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding MontoMovimientoProveedor, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource FormTextBox}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                    <TextBlock Text="Nro. Comprobante" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding ComprobanteMovimientoProveedor, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource FormTextBox}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                    <TextBlock Text="Descripcion" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding DescripcionMovimientoProveedor, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource FormTextBox}"/>
                                </StackPanel>
                                
                                <Button Grid.Column="4" Content="Registrar" Style="{StaticResource PrimaryButton}" 
                                        Command="{Binding RegistrarMovimientoProveedorCommand}" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Lista de movimientos -->
                    <TextBlock DockPanel.Dock="Top" Text="Historial de Movimientos" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                    
                    <DataGrid ItemsSource="{Binding MovimientosProveedor}" 
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="1"
                              BorderBrush="#e0e0e0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="90"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoMovimiento}" Width="80"/>
                            <DataGridTextColumn Header="Comprobante" Binding="{Binding NumeroComprobante}" Width="100"/>
                            <DataGridTextColumn Header="Descripcion" Binding="{Binding Descripcion}" Width="*"/>
                            <DataGridTextColumn Header="Debe" Binding="{Binding Debe, StringFormat=C2}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#e63946"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Haber" Binding="{Binding Haber, StringFormat=C2}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#2a9d8f"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo, StringFormat=C2}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </TabItem>
</TabControl>
</UserControl>
