<UserControl x:Class="BethersaApp.Views.PedidosView"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
         xmlns:local="clr-namespace:BethersaApp.Views"
         xmlns:converters="clr-namespace:BethersaApp.Converters"
         mc:Ignorable="d" 
         d:DesignHeight="600" d:DesignWidth="900">
    
<UserControl.Resources>
    <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="#3d5a80"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
        
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="#98c1d9"/>
        <Setter Property="Foreground" Value="#293241"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="WarningButton" TargetType="Button">
        <Setter Property="Background" Value="#ee6c4d"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
</UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" MinWidth="250"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>
        
        <!-- Lista de pedidos -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,5,0" Padding="15">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Lista de Pedidos" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="+ Nuevo Pedido" Style="{StaticResource PrimaryButton}" 
                            Command="{Binding NuevoPedidoCommand}" Margin="0,0,5,0"/>
                    <Button Content="Refrescar" Style="{StaticResource SecondaryButton}" 
                            Command="{Binding RefrescarCommand}" ToolTip="Refrescar lista"/>
                </StackPanel>
                
                <!-- Buscador -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="10,8" FontSize="13" BorderBrush="#ddd"/>
                    <TextBlock Text="Buscar por codigo o cliente..." 
                               IsHitTestVisible="False" Padding="12,10" Foreground="#999"
                               Visibility="{Binding TextoBusqueda, Converter={StaticResource InverseBoolToVis}}"/>
                </Grid>
                
                <DataGrid ItemsSource="{Binding Pedidos}" 
                          SelectedItem="{Binding PedidoSeleccionado}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="1"
                          BorderBrush="#e0e0e0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Codigo" Binding="{Binding Codigo}" Width="80"/>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente.Nombre}" Width="120"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="80"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding FechaCreacion, StringFormat=dd/MM/yyyy}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- GridSplitter para redimensionar -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" 
                      Background="#e0e0e0" Cursor="SizeWE"/>
        
        <!-- Panel de detalle/edicion -->
        <Border Grid.Column="2" Background="White" CornerRadius="8" Margin="5,0,0,0" Padding="15">
            <DockPanel>
                <!-- Botones de accion -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,15">
                    <Button Content="Cargar CSV" Style="{StaticResource PrimaryButton}" 
                            Command="{Binding CargarCsvCommand}" Margin="0,0,5,0"/>
                    <Button Content="Ver Detalle" Style="{StaticResource SecondaryButton}" 
                            Command="{Binding VerDetallePedidoCommand}" Margin="0,0,5,0"/>
                    <Button Content="Generar Remito PDF" Style="{StaticResource WarningButton}" 
                            Command="{Binding GenerarRemitoCommand}"/>
                </StackPanel>

                <!-- Mensaje de errores de validacion -->
                <Border DockPanel.Dock="Top" Background="#fff3cd" BorderBrush="#ffc107" BorderThickness="1" 
                        Padding="10" Margin="0,0,0,10" CornerRadius="5"
                        Visibility="{Binding ErroresValidacion, Converter={StaticResource BoolToVis}, 
                                     ConverterParameter=NotEmpty}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="!" FontWeight="Bold" Foreground="#856404" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ErroresValidacion}" Foreground="#856404" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                
                <!-- Formulario nuevo pedido -->
                <Border DockPanel.Dock="Top" Visibility="{Binding ModoEdicion, Converter={StaticResource BoolToVis}}" 
                        Background="#f8f9fa" Padding="15" CornerRadius="5" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Nuevo Pedido" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Codigo del Pedido" FontSize="12" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding CodigoNuevoPedido, UpdateSourceTrigger=PropertyChanged}" 
                                         Padding="8" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Cliente" FontSize="12" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding Clientes}" 
                                          SelectedItem="{Binding ClienteSeleccionado}"
                                          DisplayMemberPath="Nombre"
                                          Padding="8" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="Guardar Pedido" Style="{StaticResource PrimaryButton}" 
                                Command="{Binding GuardarPedidoCommand}" 
                                HorizontalAlignment="Right" Margin="0,15,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Grilla de productos del pedido -->
                <TextBlock DockPanel.Dock="Top" Text="Detalle del Pedido" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                
                <DataGrid ItemsSource="{Binding DetallesActuales}" 
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          BorderThickness="1"
                          BorderBrush="#e0e0e0"
                          RowHeight="35">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProductoValido}" Value="False">
                                    <Setter Property="Background" Value="#ffe6e6"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Codigo" Binding="{Binding CodigoProducto}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Descripcion" Binding="{Binding Descripcion}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnitario, StringFormat=C2}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Solicit." Binding="{Binding CantidadSolicitada}" Width="60" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="OK" Binding="{Binding EsCompleto, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                        <DataGridCheckBoxColumn Header="Parc." Binding="{Binding EsParcial, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                        <DataGridTextColumn Header="Recib." Binding="{Binding CantidadRecibida, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                        <DataGridCheckBoxColumn Header="No" Binding="{Binding NoLlego, UpdateSourceTrigger=PropertyChanged}" Width="35"/>
                        <DataGridCheckBoxColumn Header="Stock" Binding="{Binding UsaStock, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                        <DataGridTextColumn Header="C.Stk" Binding="{Binding CantidadDeStock, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C2}" Width="85" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
