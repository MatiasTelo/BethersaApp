<UserControl x:Class="BethersaApp.Views.FacturacionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BethersaApp.Views"
             xmlns:converters="clr-namespace:BethersaApp.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    
    <UserControl.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3d5a80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#2a9d8f"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>
    
    <Border Background="White" CornerRadius="8" Padding="20">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Pedidos Remitados - Pendientes de Facturacion" 
                       FontWeight="SemiBold" FontSize="16" Margin="0,0,0,15"/>
            
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,15">
                <Button Content="Refrescar" Style="{StaticResource PrimaryButton}" 
                        Command="{Binding RefrescarCommand}" Margin="0,0,10,0"/>
                <Button Content="Generar Factura" Style="{StaticResource SuccessButton}" 
                        Command="{Binding GenerarFacturaCommand}"/>
            </StackPanel>
            
            <!-- Buscador -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,15" MaxWidth="400" HorizontalAlignment="Left">
                <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="10,8" FontSize="13" BorderBrush="#ddd"/>
                <TextBlock Text="Buscar por codigo o cliente..." 
                           IsHitTestVisible="False" Padding="12,10" Foreground="#999"
                           Visibility="{Binding TextoBusqueda, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>
            
            <DataGrid ItemsSource="{Binding PedidosRemitados}" 
                      SelectedItem="{Binding PedidoSeleccionado}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="1"
                      BorderBrush="#e0e0e0"
                      RowHeight="40">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Codigo Pedido" Binding="{Binding Codigo}" Width="120"/>
                    <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente.Nombre}" Width="200"/>
                    <DataGridTextColumn Header="CUIT" Binding="{Binding Cliente.Cuit}" Width="120"/>
                    <DataGridTextColumn Header="Fecha Pedido" Binding="{Binding FechaCreacion, StringFormat=dd/MM/yyyy}" Width="120"/>
                    <DataGridTextColumn Header="Fecha Remito" Binding="{Binding FechaRemito, StringFormat=dd/MM/yyyy}" Width="120"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
