<Window x:Class="BethersaApp.Views.SeleccionFacturaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar Tipo de Factura" 
        Height="280" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Seleccione el tipo de factura a generar:" 
                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,20"/>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <!-- Factura A -->
            <Button x:Name="BtnFacturaA" Click="BtnFacturaA_Click" Margin="10" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="White" BorderBrush="#3d5a80" 
                                BorderThickness="2" CornerRadius="8" Padding="20">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="#3d5a80" Width="60" Height="60" CornerRadius="5"
                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="A" FontSize="36" FontWeight="Bold" 
                                               Foreground="White" HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Factura A" FontWeight="Bold" FontSize="14" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="(AFIP)" FontSize="10" Foreground="#666"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e3f2fd"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1976d2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
            <!-- Factura en Negro -->
            <Button x:Name="BtnFacturaNegro" Click="BtnFacturaNegro_Click" Margin="10" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="White" BorderBrush="#424242" 
                                BorderThickness="2" CornerRadius="8" Padding="20">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="#424242" Width="60" Height="60" CornerRadius="5"
                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="X" FontSize="36" FontWeight="Bold" 
                                               Foreground="White" HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Factura X" FontWeight="Bold" FontSize="14" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="(Interno)" FontSize="10" Foreground="#666"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f5f5f5"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#212121"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
        
        <Button Grid.Row="2" Content="Cancelar" Click="BtnCancelar_Click"
                HorizontalAlignment="Center" Padding="30,10" Margin="0,20,0,0"
                Background="#e0e0e0" BorderThickness="0" Cursor="Hand"/>
    </Grid>
</Window>
